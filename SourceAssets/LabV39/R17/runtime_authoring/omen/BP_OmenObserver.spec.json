{
  "asset_path": "/Game/Characters/Omen/Blueprints/BP_OmenObserver",
  "parent_class": "/Script/Engine.Actor",
  "variables": [
    {
      "name": "OmenRoot",
      "type": "object",
      "class": "/Script/Engine.Actor",
      "instance_editable": true,
      "category": "Omen|Settings",
      "tooltip": "Existing ShellUpper actor; five original Omen parts must remain attached to it."
    },
    {
      "name": "TrackingEnabled",
      "type": "bool",
      "default": "True",
      "instance_editable": true,
      "category": "Omen|Settings",
      "tooltip": "Follow the local player inside RoomBounds. False smoothly returns to the initial pose."
    },
    {
      "name": "FollowSpeed",
      "type": "float",
      "default": "1.8",
      "instance_editable": true,
      "category": "Omen|Settings",
      "tooltip": "Positive RInterpTo speed for looking at the player. Default 1.8."
    },
    {
      "name": "ReturnSpeed",
      "type": "float",
      "default": "2.0",
      "instance_editable": true,
      "category": "Omen|Settings",
      "tooltip": "Positive RInterpTo speed for returning to the original pose. Default 2.0."
    },
    {
      "name": "ModelForwardOffset",
      "type": "rotator",
      "default": "(Pitch=0,Yaw=-90,Roll=0)",
      "instance_editable": true,
      "category": "Omen|Settings",
      "tooltip": "Existing Omen artwork faces local +Y; yaw -90 converts it to look-at +X."
    },
    {
      "name": "RestRotation",
      "type": "rotator",
      "default": "(Pitch=0,Yaw=0,Roll=0)",
      "category": "Omen|Runtime",
      "tooltip": "Placed Omen rotation cached once at BeginPlay."
    },
    {
      "name": "TargetRotation",
      "type": "rotator",
      "default": "(Pitch=0,Yaw=0,Roll=0)",
      "category": "Omen|Runtime",
      "tooltip": "Current desired world rotation, selected by follow/return path."
    },
    {
      "name": "ActiveSpeed",
      "type": "float",
      "default": "2.0",
      "category": "Omen|Runtime",
      "tooltip": "Current positive smoothing speed selected by follow/return path."
    },
    {
      "name": "Initialized",
      "type": "bool",
      "default": "False",
      "category": "Omen|Runtime",
      "tooltip": "True only after the original Omen pose has been cached successfully."
    },
    {
      "name": "IsTrackingPlayer",
      "type": "bool",
      "default": "False",
      "category": "Omen|Runtime",
      "tooltip": "Debug state: true when the local pawn is in the room and its camera is valid."
    }
