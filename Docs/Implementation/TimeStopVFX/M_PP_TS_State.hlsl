float2 vuv=GetViewportUV(Parameters);
float2 uv=ViewportUVToSceneTextureUV(vuv,14);
float3 source=SceneTextureLookup(uv,14,false).rgb;
float2 depthUV=ViewportUVToSceneTextureUV(vuv,1);
Depth=SceneTextureLookup(ClampSceneTextureUV(depthUV,1),1,false).r;
float2 screenXY=vuv*float2(2,-2)+float2(-1,1);
float4 tw=mul(float4(GetScreenPositionForProjectionType(screenXY,Depth),Depth,1),PrimaryView.ScreenToTranslatedWorld);
float3 originT=DFFastToTranslatedWorld(Origin.xyz,PrimaryView.PreViewTranslation);
float d=length(tw.xyz/tw.w-originT);
float valid=1-step(1000000,Depth);
float domain=(1-smoothstep(Radius-160,Radius+160,d))*step(1,Radius);
float warm=smoothstep(.35,.65,(source.r-source.b)/max(max(source.r,source.g),.001))*smoothstep(.10,.35,source.r);
float mask=Weight*lerp(.50,domain*smoothstep(80,200,Depth),valid)*(1-warm*.85);
float lum=dot(source,float3(.2126,.7152,.0722));
float3 desat=lerp(source,lum.xxx,Desaturation);
float3 cold=desat*float3(.52,.61,.88);
float3 shadowLift=float3(.009,.012,.029)*(1-smoothstep(.02,.35,lum));
float highlight=smoothstep(.68,1,lum)*.40;
cold=lerp(cold,desat,highlight)+shadowLift;
float2 du=GetSceneTextureViewSize(1).zw*max(1,View.ViewSizeAndInvSize.y/1080);
float dx1=SceneTextureLookup(ClampSceneTextureUV(depthUV+float2(du.x,0),1),1,false).r;
float dx2=SceneTextureLookup(ClampSceneTextureUV(depthUV-float2(du.x,0),1),1,false).r;
float dy1=SceneTextureLookup(ClampSceneTextureUV(depthUV+float2(0,du.y),1),1,false).r;
float dy2=SceneTextureLookup(ClampSceneTextureUV(depthUV-float2(0,du.y),1),1,false).r;
float edge=saturate((max(abs(dx1-Depth),abs(dx2-Depth))+max(abs(dy1-Depth),abs(dy2-Depth)))/max(Depth*.018,7));
float3 graded=lerp(desat,cold,TintStrength)+edge*EdgeIntensity*float3(.20,.29,.62)*valid;
return lerp(source,graded,saturate(mask));
